/* Full-screen host, flex-centered so the track needs no manual width/margin centering math --
   the only child, so align-items: center is all that's needed to keep it horizontally centered. */
.care-meter-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
}

/* Center-top. Raised 16px (72 -> 56) per feedback, which puts it 4px inside the top World Pan Bar
   strip (ZooNavigationBars.uss: height 60px) on the occasions that strip is shown -- the strip is
   a translucent hint only, so the overlap is cosmetic, not an input conflict.
   Material: a routed slideway in birch ("wood-cavity", theme.uss) that the stained fill slides
   along, like the toggle track in the Montessori UI kit. */
.care-meter-track {
    margin-top: 56px;
    width: 50%;
    height: 26px;
    /* Same wood as the rest of the kit, but on the contrast-boosted grain map (a small bar needs
       a stronger grain than the big panels to read as wood at all). Overrides wood-cavity's texture. */
    background-image: url("project://database/Assets/_Game/UI/Textures/Birch_Grain_Boost.png?fileID=2800000&guid=0075f846fa085b2d4954395d80da00e3&type=3#Birch_Grain_Boost");
    -unity-background-image-tint-color: #DDBFA4;
    background-size: 2048px 2048px;
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
    border-bottom-left-radius: 13px;
    border-bottom-right-radius: 13px;
}

/* Left-anchored lane that grows with Care Meter progress (CareMeterUIController, driven by
   ZooManager.OnCareHeartsChanged) -- width transition (not an instant snap) so each heart gain
   reads as a small, satisfying grow rather than a jump cut, matching the "gentle" pointer already
   applied to the camera focus/occlusion-fade timing elsewhere in this phase.
   The lane itself draws nothing: its right edge is the fill's leading edge, which is where the
   wooden heart marker (a child, added by the controller) is anchored. The visible stain is a
   separate child so only IT is half-transparent -- opacity on the lane would fade the heart too. */
.care-meter-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0%;
    transition-property: width;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-sine;
}

/* Cherry-stained birch at 50% opacity: the grain texture is multiplied by the dye like the other
   wood pieces. Rounded to the track's inner curve itself, since the track no longer clips (it
   can't -- overflow: hidden would also cut off the heart marker where it overhangs the bar). */
.care-meter-stain {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: var(--color-rose-birch);
    background-image: url("project://database/Assets/_Game/UI/Textures/Birch_Grain_Boost.png?fileID=2800000&guid=0075f846fa085b2d4954395d80da00e3&type=3#Birch_Grain_Boost");
    -unity-background-image-tint-color: var(--color-rose-birch);
    background-size: 2048px 2048px;
    background-repeat: repeat;
    background-position: center;
    border-top-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.30);
    border-bottom-width: 3px;
    border-bottom-color: var(--color-side-cherry);
    opacity: 0.5;
}

/* Wooden heart peg riding the fill's leading edge (WoodenHeart in CareMeterUIController draws
   its shape). "left: 100%" of the lane's width + the negative margin centers it on the edge, so
   it tracks the same width transition for free. It's taller than the bar so it overhangs
   it like a peg standing in the slideway. */
.care-meter-heart {
    position: absolute;
    left: 100%;
    top: 50%;
    width: 40px;
    height: 38px;
    margin-left: -20px;
    margin-top: -18px;
}

/* Placeholder heart-gain spark (CareMeterUIController.SpawnCareSpark) -- size/position are set
   per-instance in C# (it needs to land at wherever the fill's new edge actually ended up), this
   just supplies the shape/color and self-fades via the controller's own opacity animation, not a
   USS transition (it's spawned and removed by C#, not toggled by a persistent class). Parented to
   care-meter-root, NOT care-meter-track, so it is positioned in plain screen coordinates and
   isn't affected by the track's own layout or any clipping a future style might add to it. */
.care-meter-spark {
    position: absolute;
    background-color: var(--color-gold-birch);
}
