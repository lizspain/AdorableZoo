<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/_Game/UI/USS/theme.uss" />
    <Style src="project://database/Assets/_Game/UI/USS/SettingsUI.uss" />
    <ui:VisualElement name="settings-root" class="settings-root rainbow-zoo-theme" picking-mode="Ignore">
        <ui:VisualElement name="settings-gate" class="settings-gate wood-block wood--natural">
            <ui:VisualElement name="settings-gate-fill" class="settings-gate-fill" />
        </ui:VisualElement>

        <ui:VisualElement name="settings-menu" class="settings-panel wood-slab" style="display: none;">
            <ui:Label text="Settings" class="settings-panel-title" />
            <ui:Button name="unlock-button" text="Unlock All Animals" class="settings-button wood-block wood--cobalt" />
            <ui:Button name="reset-button" text="Reset Zoo" class="settings-button wood-block wood--cherry" />
            <ui:Button name="close-button" text="Close" class="settings-button wood-block wood--natural" />
        </ui:VisualElement>

        <ui:VisualElement name="reset-confirm" class="settings-panel wood-slab" style="display: none;">
            <ui:Label text="This deletes your whole zoo. Are you sure?" class="settings-panel-title settings-panel-title--wrap" />
            <ui:Button name="reset-confirm-yes" text="Yes, delete my zoo" class="settings-button wood-block wood--cherry" />
            <ui:Button name="reset-confirm-cancel" text="Cancel" class="settings-button wood-block wood--natural" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
